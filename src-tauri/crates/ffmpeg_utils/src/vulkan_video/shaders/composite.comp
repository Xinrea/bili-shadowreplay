#version 450
// One invocation owns one NV12 2x2 block. Overlay values are premultiplied
// nonlinear BT.709. sRGB video is converted before blending; alpha is coverage,
// never transfer-encoded. No full-frame RGB intermediate or CPU mapping.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D base_y;
layout(binding = 1) uniform sampler2D base_uv;
layout(binding = 2) uniform sampler2D overlay_rgba;
layout(binding = 3) uniform writeonly image2D output_y;
layout(binding = 4) uniform writeonly image2D output_uv;
layout(push_constant) uniform Options {
    uint width; uint height; uint has_base; uint srgb_base;
} opt;

vec3 srgb_to_bt709(vec3 encoded) {
    // The SDR contract clips reconstructed out-of-gamut/extended-range RGB.
    // Both transfers have BT.709 primaries; no gamut matrix or HDR tone map.
    vec3 s = clamp(encoded, 0.0, 1.0);
    vec3 linear = mix(pow((s + 0.055) / 1.055, vec3(2.4)), s / 12.92,
                      lessThanEqual(s, vec3(0.04045)));
    return mix(1.099 * pow(linear, vec3(0.45)) - 0.099, 4.5 * linear,
               lessThan(linear, vec3(0.018)));
}

void main() {
    ivec2 uv_pos = ivec2(gl_GlobalInvocationID.xy);
    if (uv_pos.x >= int(opt.width / 2) || uv_pos.y >= int(opt.height / 2)) return;
    const vec3 krgb = vec3(0.2126, 0.7152, 0.0722);
    const float y_scale = 219.0 / 255.0;
    const float uv_scale = 224.0 / 255.0;
    vec2 base_chroma = opt.has_base != 0 ? texelFetch(base_uv, uv_pos, 0).rg
                                        : vec2(128.0 / 255.0);
    if (opt.srgb_base != 0) {
        vec2 cbcr = (base_chroma - vec2(128.0 / 255.0)) / uv_scale;
        vec3 rgb_sum = vec3(0.0);
        for (int y = 0; y < 2; ++y) {
            for (int x = 0; x < 2; ++x) {
                ivec2 pos = uv_pos * 2 + ivec2(x, y);
                float luma = (texelFetch(base_y, pos, 0).r - 16.0 / 255.0) / y_scale;
                float red = luma + 2.0 * (1.0 - krgb.r) * cbcr.y;
                float blue = luma + 2.0 * (1.0 - krgb.b) * cbcr.x;
                float green = (luma - krgb.r * red - krgb.b * blue) / krgb.g;
                vec4 layer = texelFetch(overlay_rgba, pos, 0);
                vec3 rgb = srgb_to_bt709(vec3(red, green, blue)) * (1.0 - layer.a)
                         + layer.rgb;
                imageStore(output_y, pos, vec4(16.0 / 255.0 + y_scale * dot(rgb, krgb), 0.0, 0.0, 1.0));
                rgb_sum += rgb * 0.25;
            }
        }
        float luma = dot(rgb_sum, krgb);
        vec2 chroma = vec2((rgb_sum.b - luma) / (2.0 * (1.0 - krgb.b)),
                          (rgb_sum.r - luma) / (2.0 * (1.0 - krgb.r)));
        imageStore(output_uv, uv_pos, vec4(vec2(128.0 / 255.0) + uv_scale * chroma, 0.0, 1.0));
        return;
    }
    vec4 coverage = vec4(0.0);
    for (int y = 0; y < 2; ++y) {
        for (int x = 0; x < 2; ++x) {
            ivec2 pos = uv_pos * 2 + ivec2(x, y);
            vec4 layer = texelFetch(overlay_rgba, pos, 0);
            float base = opt.has_base != 0 ? texelFetch(base_y, pos, 0).r : 16.0 / 255.0;
            float luma = base * (1.0 - layer.a)
                + y_scale * dot(layer.rgb, krgb) + (16.0 / 255.0) * layer.a;
            imageStore(output_y, pos, vec4(luma, 0.0, 0.0, 1.0));
            coverage += layer * 0.25;
        }
    }
    // Coverage-weighted 2x2 chroma: the affine RGB->YCbCr transform commutes
    // with premultiplied blending and averaging, so the base stays in NV12.
    float luma = dot(coverage.rgb, krgb);
    vec2 foreground = vec2((coverage.b - luma) / (2.0 * (1.0 - krgb.b)),
                           (coverage.r - luma) / (2.0 * (1.0 - krgb.r)));
    vec2 chroma = base_chroma * (1.0 - coverage.a) + uv_scale * foreground
        + vec2(128.0 / 255.0) * coverage.a;
    imageStore(output_uv, uv_pos, vec4(chroma, 0.0, 1.0));
}
