{
  "build": {
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8054"
  },
  "bundle": {
    "active": true,
    "resources": {
      "silero_vad.onnx": "silero_vad.onnx",
      "crates/native-overlay/assets/EMOJI-OFL.txt": "licenses/Noto-Emoji-OFL.txt",
      "crates/native-overlay/assets/UNICODE-LICENSE.txt": "licenses/Unicode.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "createUpdaterArtifacts": true
  },
  "productName": "bili-shadowreplay",
  "version": "../package.json",
  "identifier": "cn.vjoi.bilishadowreplay",
  "plugins": {
    "sql": {
      "preload": ["sqlite:data_v2.db"]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["bsr"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4NDI2QURBMzM0NTYxMEMKUldRTVlVVXoybXBDbUR4a2hjQ0NsMHpaeDk5eFQvbDVWdllpS05qMXBxNWZSMEY1YU4xYUtzUkQK",
      "endpoints": [
        "https://github.com/Xinrea/bili-shadowreplay/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "assetProtocol": {
        "scope": ["**"],
        "enable": true
      },
      "csp": null
    }
  }
}
