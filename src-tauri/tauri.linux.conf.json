{
  "bundle": {
    "linux": {
      "deb": {
        "depends": [
          "libavformat60",
          "libavcodec60",
          "libavutil58",
          "libswresample4",
          "libicu74",
          "libharfbuzz0b",
          "libharfbuzz-subset0",
          "libfreetype6",
          "libfontconfig1",
          "libpng16-16t64",
          "libjpeg-turbo8",
          "libexpat1",
          "zlib1g"
        ]
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "title": "BiliBili ShadowReplay",
        "width": 1300,
        "height": 600,
        "transparent": false,
        "decorations": false
      }
    ]
  }
}
