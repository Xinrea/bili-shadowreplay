{
  "bundle": {
    "macOS": {
      "minimumSystemVersion": "15.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "files": {
        "Frameworks": "./target/ffmpeg-runtime"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "title": "BiliBili ShadowReplay",
        "width": 1300,
        "height": 600,
        "transparent": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 22 }
      }
    ]
  },
  "build": {
    "beforeBundleCommand": "node scripts/bundle-macos-ffmpeg.mjs"
  }
}
