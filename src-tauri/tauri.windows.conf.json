{
  "productName": "bili-shadowreplay-cpu",
  "identifier": "cn.vjoi.bilishadowreplay",
  "build": {
    "beforeBuildCommand": "node scripts/prepare_windows_runtime.cjs && yarn build",
    "beforeBundleCommand": "node scripts/copy_sherpa_runtime.cjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "title": "BiliBili ShadowReplay",
        "width": 1300,
        "height": 600,
        "transparent": false,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "resources": {
      "silero_vad.onnx": "silero_vad.onnx",
      "windows-runtime": ".",
      "crates/native-overlay/assets/EMOJI-OFL.txt": "licenses/Noto-Emoji-OFL.txt",
      "crates/native-overlay/assets/UNICODE-LICENSE.txt": "licenses/Unicode.txt"
    }
  }
}
